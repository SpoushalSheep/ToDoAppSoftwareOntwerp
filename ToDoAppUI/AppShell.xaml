<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ToDoAppUI.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:ToDoAppUI"
    Title="ToDoAppUI">

    <ShellContent
        Title="ToDo"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" 
        />

    <ShellContent
    Title="Personen"
    ContentTemplate="{DataTemplate local:PersonenLijstPage}"
    Route="PersonenLijstPage" />

</Shell>
